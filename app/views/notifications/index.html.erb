<div class="notification-list">
  <div class="header">
    <h1 class="title">Notifications</h1>
    <% if @notifications.any? %>
      <%= button_to "Clear all", notifications_clearance_path, class: "clear", data: { qa: "clear-notifications" } %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <ul class="items">
      <% @notifications.each do |notification| %>
        <%= render "notification", notification: notification %>
      <% end %>
    </ul>
  <% else %>
    <p class="empty">No unread notifications</p>
  <% end %>
</div>
